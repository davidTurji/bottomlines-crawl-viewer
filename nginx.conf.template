# nginx config for the viewer SPA on Cloud Run, modeled on
# bottomlines-manage-console/nginx.conf plus the /api reverse proxy from
# bottomlines-app's house pattern.
#
# This is a TEMPLATE: nginx:alpine's stock entrypoint runs every file in
# /etc/nginx/templates/*.template through envsubst at container start
# (see docker-entrypoint.sh, which derives CRAWLER_API_HOST from
# CRAWLER_API_URL first). Only ${CRAWLER_API_URL} and ${CRAWLER_API_HOST}
# are substituted — every other $var below is nginx's own.
#
# Port 8080 is Cloud Run's requirement (its ingress sends traffic there;
# the default 80 is closed).
# ── FLOOD GATE ───────────────────────────────────────────────────────
#
# This service is public and unauthenticated, so the only thing standing
# between a stranger with a loop and a bandwidth bill is a limit. Cloud
# Armor is the "proper" answer and needs a global load balancer in front,
# which is ~$25-30/month of fixed cost to guard a service whose realistic
# bill is nothing. So the limit lives here, in the container, for free.
#
# THE CLIENT IP IS NOT $remote_addr. Cloud Run terminates TLS and proxies
# to the container, so $remote_addr is Google's frontend and every visitor
# would share one bucket -- the first person through the door would spend
# everyone's budget. The real address is the FIRST entry of
# X-Forwarded-For; the rest of that header is attacker-suppliable and must
# not be trusted, which is exactly why the regex takes only the first.
map $http_x_forwarded_for $demo_client_ip {
    "~^(?<xff_first>[^,]+)"  $xff_first;
    default                  $remote_addr;
}

# 500 req/s sustained, per IP, with a 1000-request burst.
#
# THIS IS NOT A COST CONTROL. maxInstances is, and it is the hard ceiling:
# a flood cannot buy more machine than that no matter what it does. What
# this rule is for is FAIRNESS -- stopping one address from monopolising
# the single instance so that everybody else's page stops loading.
#
# Which is why the threshold is set where it is. A measured end-to-end
# session -- all four pages, the search boxes, expanding rows, three chat
# answers and the Excel export -- makes 26 requests. This demo is being
# sent to people who have never seen the product and will click everything,
# repeatedly, possibly several of them behind one office address. None of
# that comes within two orders of magnitude of 500 a second.
#
# A REAL VISITOR SEEING A 429 COSTS MORE THAN THE BANDWIDTH IT SAVES.
# That is the whole trade, and it is why this number is set high and not
# low. Anything sustaining five hundred requests a second from one address
# is industrial, not a person who is interested.
#
# 10m of shared memory holds roughly 160k addresses.
limit_req_zone $demo_client_ip zone=demo_flood:10m rate=500r/s;

# 429, not the default 503: this is the client being told to slow down, not
# the server claiming to be broken.
limit_req_status 429;

# Per-instance, and maxInstances is 1, so this IS the ceiling rather than a
# number to multiply. A distributed flood from many addresses walks around
# any per-IP rule; that case is bounded by the instance cap instead.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # This is a private, credentialed report viewer: never indexed, and
    # never leaking report URLs (which carry share tokens) via Referer.
    # NOTE: nginx add_header does NOT inherit into a location that adds
    # its own headers, so every location below that uses add_header must
    # repeat these two.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;

    # Reverse proxy to the crawler API. The trailing slash on proxy_pass
    # strips the /api prefix, so /api/v1/viewer/... upstream becomes
    # /v1/viewer/... — the exact behavior of the vite.config.ts dev proxy
    # (rewrite ^/api -> ""). Same-origin by construction, so the httpOnly
    # session cookie set by POST /v1/viewer/auth sticks with no CORS and
    # no SameSite gymnastics.
    location /api/ {
        limit_req zone=demo_flood burst=1000 nodelay;
        proxy_pass ${CRAWLER_API_URL}/;
        proxy_set_header Host ${CRAWLER_API_HOST};
        # Forward the viewer's own credentials (session cookie travels in
        # Cookie automatically; Authorization passes through untouched).
        # Deliberately NOT injecting any shared key here: that would
        # authenticate every caller and reduce the login to decoration.
        proxy_set_header Authorization $http_authorization;
        proxy_ssl_server_name on;
        proxy_read_timeout 120s;
        # SSE-friendly: the future chat endpoint streams text/event-stream
        # frames, and nginx's default response buffering would hold them
        # back until the buffer fills. Harmless for plain JSON responses.
        proxy_buffering off;
    }

    # Long-cache immutable Vite chunks (they have hashed filenames).
    location /assets/ {
        # Higher burst still: one page load pulls several assets at once,
        # and these are immutable and cached for a year, so a repeat
        # visitor asks for none of them.
        limit_req zone=demo_flood burst=2000 nodelay;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    # index.html must NOT be cached: it names the current asset hashes,
    # so a stale copy pins the browser to a previous build. no-store per
    # the viewer's privacy posture (report data behind it is credentialed).
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # SPA fallback. Every non-asset URL that isn't a real file lands on
    # the React shell and the router decides what to render. The fallback
    # is served with THIS location's headers (not the /index.html
    # location's), so the no-store rule is repeated here.
    location / {
        limit_req zone=demo_flood burst=1000 nodelay;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri $uri/ /index.html;
    }
}
