# nginx config for the viewer SPA on Cloud Run, modeled on
# bottomlines-manage-console/nginx.conf plus the /api reverse proxy from
# bottomlines-app's house pattern.
#
# This is a TEMPLATE: nginx:alpine's stock entrypoint runs every file in
# /etc/nginx/templates/*.template through envsubst at container start
# (see docker-entrypoint.sh, which derives CRAWLER_API_HOST from
# CRAWLER_API_URL, and CORE_API_HOST from CORE_API_URL, first). Only those
# four are substituted; every other $var below is nginx's own.
#
# Port 8080 is Cloud Run's requirement (its ingress sends traffic there;
# the default 80 is closed).
# Shared per-instance flood ceiling. Do not derive this key from any client
# header: arbitrary X-Forwarded-For prefixes must never mint a fresh budget.
# Normal demo page loads need about 26 requests; retain the existing generous
# 500 req/s ceiling and asset burst. This is not a distributed or billing cap:
# instance limits and any shared edge control are separate deployment settings.
limit_req_zone $server_name zone=demo_flood:1m rate=500r/s;
limit_req_status 429;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    # Inherited by direct /index.html and download paths as well.
    limit_req zone=demo_flood burst=1000 nodelay;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; worker-src 'self' blob:; media-src 'self' blob:" always;

    # This is a private, credentialed report viewer: never indexed, and
    # never leaking report URLs (which carry share tokens) via Referer.
    # NOTE: nginx add_header does NOT inherit into a location that adds
    # its own headers, so every location below that uses add_header must
    # repeat the security headers as well.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header Referrer-Policy "no-referrer" always;

    # Reverse proxy to the crawler API. The trailing slash on proxy_pass
    # strips the /api prefix, so /api/v1/viewer/... upstream becomes
    # /v1/viewer/... — the exact behavior of the vite.config.ts dev proxy
    # (rewrite ^/api -> ""). Same-origin by construction, so the httpOnly
    # session cookie set by POST /v1/viewer/auth sticks with no CORS and
    # no SameSite gymnastics.
    location /api/ {
        limit_req zone=demo_flood burst=1000 nodelay;
        proxy_pass ${CRAWLER_API_URL}/;
        proxy_set_header Host ${CRAWLER_API_HOST};
        # Forward the viewer's own credentials (session cookie travels in
        # Cookie automatically; Authorization passes through untouched).
        # Deliberately NOT injecting any shared key here: that would
        # authenticate every caller and reduce the login to decoration.
        proxy_set_header Authorization $http_authorization;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        proxy_read_timeout 120s;
        # SSE-friendly: the future chat endpoint streams text/event-stream
        # frames, and nginx's default response buffering would hold them
        # back until the buffer fills. Harmless for plain JSON responses.
        proxy_buffering off;
    }

    # THE MAILED WORKBOOK LINK on our own domain (David, 2026-11-02): a
    # report mail too big to attach carries
    # https://pathfinder.bottomlines.ai/crawler/report-files/<token>, and
    # this hands exactly that path to core-api, which checks the signed,
    # 24-hour token and streams the file. Nothing else of core-api is
    # reachable here: only this prefix, only GET (HEAD rides along), and
    # none of the reader's credentials travel (the viewer's session cookie
    # and any Authorization stay behind; the token is the only grant).
    location ^~ /crawler/report-files/ {
        limit_except GET { deny all; }
        proxy_pass ${CORE_API_URL}/crawler/report-files/;
        proxy_set_header Host ${CORE_API_HOST};
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        # HTTP/1.1 upstream, so core-api's body comes chunked with its own
        # end marker: a stream cut short upstream reaches the reader as a
        # FAILED download, never as a finished, truncated file (core-api
        # reads the whole file first for exactly that reason).
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # The hop to core-api is TLS the browser would have verified.
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth 3;
        # A whole report zip streams for minutes: never buffered to disk
        # here. The Cloud Run request limit (deploy.yml, --timeout) is the
        # same hour as core-api's.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # This origin carries the viewer's session: core-api never sets a
        # cookie on it, and its answers are files or JSON, never a page
        # that could run script here.
        proxy_hide_header Set-Cookie;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Long-cache immutable Vite chunks (they have hashed filenames).
    location /assets/ {
        # Higher burst still: one page load pulls several assets at once,
        # and these are immutable and cached for a year, so a repeat
        # visitor asks for none of them.
        limit_req zone=demo_flood burst=2000 nodelay;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; worker-src 'self' blob:; media-src 'self' blob:" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri =404;
    }

    # index.html must NOT be cached: it names the current asset hashes,
    # so a stale copy pins the browser to a previous build. no-store per
    # the viewer's privacy posture (report data behind it is credentialed).
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; worker-src 'self' blob:; media-src 'self' blob:" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
    }

    # SPA fallback. Every non-asset URL that isn't a real file lands on
    # the React shell and the router decides what to render. The fallback
    # is served with THIS location's headers (not the /index.html
    # location's), so the no-store rule is repeated here.
    location / {
        limit_req zone=demo_flood burst=1000 nodelay;
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self'; frame-src 'none'; worker-src 'self' blob:; media-src 'self' blob:" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri $uri/ /index.html;
    }
}
