# Build-time settings for the PUBLIC DEMO build, loaded by `vite build --mode demo`.
#
# The demo is the same SPA as the customer viewer, built against the mock
# adapter instead of the crawler API: every api.* call short-circuits to the
# fixture in src/lib/mockData.ts, so the page has no backend, no database and
# no sign-in. That is the whole design. It is why the demo can sit deployed
# forever at no cost and cannot leak a customer's report: there is nothing
# behind it to leak.
#
# NOTHING HERE IS SECRET. These are build flags, and everything they switch
# on is fixture data about a fictional customer.

# Serve the report from the fixture. Also switches the sign-in gate off,
# because a mock response never answers 401 (see LoginGate).
VITE_MOCK=true

# The Ask AI panel. Hidden by default because the real backend ships no chat
# endpoint; the mock answers off the same fixture the tiles read, so on the
# demo it can never contradict the page it sits on.
VITE_ENABLE_CHAT=true
